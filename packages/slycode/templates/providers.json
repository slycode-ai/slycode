{
  "schemaVersion": 1,
  "providers": {
    "claude": {
      "id": "claude",
      "displayName": "Claude Code",
      "command": "claude",
      "install": "npm i -g @anthropic-ai/claude-code",
      "permissions": {
        "flag": "--dangerously-skip-permissions",
        "label": "Skip permissions",
        "default": true
      },
      "resume": {
        "supported": true,
        "type": "flag",
        "flag": "--resume",
        "detectSession": true,
        "sessionDir": "~/.claude/projects/"
      },
      "sessionIdFlag": "--session-id",
      "prompt": {
        "type": "positional"
      },
      "instructionFile": "CLAUDE.md",
      "transport": "pty-scrape",
      "agentIdentity": "Claude",
      "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "color": {
        "hex": "#d4764e",
        "tailwind": {
          "bg": "bg-blue-100 dark:bg-blue-900/40",
          "text": "text-blue-700 dark:text-blue-300"
        },
        "token": "neon-blue"
      },
      "detect": {
        "files": [
          "CLAUDE.md"
        ],
        "dirs": [
          ".claude"
        ]
      },
      "model": {
        "flag": "--model",
        "available": [
          {
            "id": "fable",
            "label": "Fable",
            "description": "Most intelligent, Mythos-class"
          },
          {
            "id": "sonnet",
            "label": "Sonnet",
            "description": "Fast, capable"
          },
          {
            "id": "opus",
            "label": "Opus",
            "description": "Most capable"
          },
          {
            "id": "haiku",
            "label": "Haiku",
            "description": "Fastest, lightweight"
          }
        ]
      }
    },
    "codex": {
      "id": "codex",
      "displayName": "Codex CLI",
      "command": "codex",
      "install": "npm i -g @openai/codex",
      "permissions": {
        "flag": "--yolo",
        "label": "YOLO mode",
        "default": true
      },
      "resume": {
        "supported": true,
        "type": "subcommand",
        "subcommand": "resume",
        "lastFlag": "--last",
        "detectSession": true
      },
      "prompt": {
        "type": "positional"
      },
      "instructionFile": "AGENTS.md",
      "altInstructionFile": "CODEX.md",
      "transport": "pty-scrape",
      "agentIdentity": "Codex",
      "idPattern": "^[0-9a-f][0-9a-f-]{7,40}[0-9a-f]$",
      "color": {
        "hex": "#6b8fae",
        "tailwind": {
          "bg": "bg-emerald-100 dark:bg-emerald-900/40",
          "text": "text-emerald-700 dark:text-emerald-300"
        },
        "token": "emerald"
      },
      "detect": {
        "files": [
          "AGENTS.md"
        ],
        "dirs": [
          ".codex",
          ".agents"
        ]
      },
      "model": {
        "flag": "-m",
        "available": [
          {
            "id": "gpt-5.4",
            "label": "GPT-5.4",
            "description": "Latest frontier agentic coding model"
          },
          {
            "id": "gpt-5.4-mini",
            "label": "GPT-5.4 Mini",
            "description": "Smaller frontier agentic coding model"
          },
          {
            "id": "gpt-5.3-codex",
            "label": "GPT-5.3 Codex",
            "description": "Codex-optimized agentic coding model"
          },
          {
            "id": "gpt-5.2-codex",
            "label": "GPT-5.2 Codex",
            "description": "Frontier agentic coding model"
          }
        ]
      }
    },
    "gemini": {
      "id": "gemini",
      "displayName": "Gemini CLI",
      "command": "gemini",
      "install": "npm i -g @google/gemini-cli",
      "permissions": {
        "flag": "--yolo",
        "label": "YOLO mode",
        "default": true
      },
      "resume": {
        "supported": true,
        "type": "flag",
        "flag": "--resume",
        "detectSession": true
      },
      "sessionIdFlag": "--session-id",
      "prompt": {
        "type": "flag",
        "interactive": "-i",
        "nonInteractive": "-p"
      },
      "instructionFile": "GEMINI.md",
      "transport": "pty-scrape",
      "agentIdentity": "Gemini",
      "idPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "color": {
        "hex": "#8b7ec8",
        "tailwind": {
          "bg": "bg-purple-100 dark:bg-purple-900/40",
          "text": "text-purple-700 dark:text-purple-300"
        },
        "token": "amber"
      },
      "detect": {
        "files": [
          "GEMINI.md"
        ],
        "dirs": [
          ".gemini"
        ]
      },
      "model": {
        "flag": "-m",
        "available": [
          {
            "id": "gemini-3-flash-preview",
            "label": "3 Flash Preview",
            "description": "Latest preview model"
          },
          {
            "id": "gemini-3.1-flash-lite-preview",
            "label": "3.1 Flash Lite Preview",
            "description": "Lightweight preview model"
          },
          {
            "id": "gemini-2.5-flash",
            "label": "2.5 Flash",
            "description": "Fast, capable"
          },
          {
            "id": "gemini-2.5-flash-lite",
            "label": "2.5 Flash Lite",
            "description": "Lightweight, efficient"
          }
        ]
      }
    },
    "opencode": {
      "id": "opencode",
      "displayName": "OpenCode",
      "command": "opencode",
      "install": "npm i -g opencode-ai",
      "transport": "opencode-api",
      "permissions": {
        "flag": "--auto",
        "label": "Auto-approve",
        "default": true
      },
      "resume": {
        "supported": true,
        "type": "flag",
        "flag": "--session",
        "requiresId": true,
        "detectSession": true
      },
      "prompt": {
        "type": "transport"
      },
      "instructionFile": "AGENTS.md",
      "idPattern": "^ses_[A-Za-z0-9]{20,40}$",
      "color": {
        "hex": "#e0a458",
        "tailwind": {
          "bg": "bg-amber-100 dark:bg-amber-900/40",
          "text": "text-amber-700 dark:text-amber-300"
        },
        "token": "amber"
      },
      "agentIdentity": "OpenCode",
      "auth": {
        "check": [
          "opencode",
          "auth",
          "list"
        ]
      },
      "detect": {
        "files": [
          "opencode.json",
          "opencode.jsonc"
        ],
        "dirs": [
          ".opencode"
        ]
      },
      "model": {
        "flag": "-m",
        "available": [],
        "refreshCommand": [
          "opencode",
          "models"
        ],
        "recentCommand": [
          "opencode",
          "db",
          "select model from session where model is not null and parent_id is null order by time_updated desc limit 50"
        ]
      },
      "instructionFallbacks": [
        "CLAUDE.md"
      ]
    }
  },
  "defaults": {
    "global": {
      "provider": "claude",
      "skipPermissions": true
    }
  }
}
